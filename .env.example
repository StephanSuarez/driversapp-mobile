# Backend DriversApp
API_BASE_URL=https://services.example.com
WS_URL=wss://services.example.com
API_PREFIX=/api/ms/driversapp-service

# Llave compartida para endpoints de cambio de status / cancelación de ride
RIDE_AUTH_KEY=

# Mapbox
MAPBOX_TOKEN=
MAPBOX_STYLE_URL=mapbox://styles/<usuario>/<style-id>
MAPBOX_DIRECTIONS_URL=https://api.mapbox.com/directions/v5/mapbox

# Intervalo (segundos) para reportar ubicación del conductor al backend.
LOCATION_UPDATE_INTERVAL_SECONDS=15
